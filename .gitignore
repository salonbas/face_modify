# macOS
*.DS_Store

# images (keep repo lightweight)
*.png
*.jpg
*.jpeg

# 例外：實驗產出的結果圖要進 git，不然重跑才有
!Shen/results/**/*.png
!Shen/results/**/*.jpg
!Shen/results/**/*.jpeg

# 金鑰絕對不能進 repo
*.pem
*.key
.env.local
.runpod_api_key
runpod.txt
*_api_key
*_token

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.coverage
.coverage.*
htmlcov/

# Environment / local config
.env
.env.*
