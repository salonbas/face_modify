venv/
.venv/
.venv311/
venv311/
__pycache__/
*.py[cod]
*.pyd
*.pyo
.Python
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.cache/

# Experiment artifacts
# Keep runtime output out by default, then explicitly version the formal
# calibration, benchmark and diagnostic evidence below.
results/*

# Versioned meeting-report assets (small curated visualizations only)
!docs/reports/
!docs/reports/**/
!docs/reports/**/*.png

# Keep tracked placeholders / docs under results
!results/.gitkeep
!results/**/README.txt
!results/**/*README*

# Formal calibration authority: configs, metadata, thresholds and tabular
# calibration evidence.  Derived embedding arrays remain local caches.
!results/calibration/
!results/calibration/**/
!results/calibration/**/*.json
!results/calibration/**/*.csv
results/calibration/**/*.npz
results/calibration/**/failures.csv

# Frozen-20 formal four-method benchmark authority.  Serialized images and
# visualizations are reproducible runtime assets; curated report figures live
# under docs/reports instead.
!results/transfer/
results/transfer/*
!results/transfer/lfw_attack_dev_20_four_method_v3/
results/transfer/lfw_attack_dev_20_four_method_v3/**/*.png
results/transfer/lfw_attack_dev_20_four_method_v3/**/*.jpg
results/transfer/lfw_attack_dev_20_four_method_v3/**/*.jpeg
results/transfer/lfw_attack_dev_20_four_method_v3/**/*.npy

# Compact formal regression evidence; trajectory frames, tensors and
# checkpoints are deliberately local-only.
!results/diagnostics/
results/diagnostics/*
!results/diagnostics/lfw_gradient_trajectory_v1/
results/diagnostics/lfw_gradient_trajectory_v1/*
!results/diagnostics/lfw_gradient_trajectory_v1/regression_smoke.json
!results/diagnostics/lfw_gradient_trajectory_v1/regression_smoke.csv

# Local personal notes (also archived under archive/docs/)
COMMANDS.local.md

# Benchmark image copies (provenance docs stay tracked)
data/benchmark/images/
data/benchmark/_download/

# Raw LFW images are installed by scripts/setup_research_assets.py after the
# user accepts the upstream research terms.  They remain outside Git until an
# explicit redistribution permission is recorded.  The manifest, official
# pair definitions and frozen split definitions are research inputs and must
# remain versioned.
data/datasets/lfw/*
!data/datasets/lfw/README.md
!data/datasets/lfw/manifest.csv
!data/datasets/lfw/pairs/
!data/datasets/lfw/pairs/**
!data/datasets/lfw/evaluation_splits/
!data/datasets/lfw/evaluation_splits/**

# Repo-local downloaded model assets are intentionally untracked because their
# upstream redistribution terms do not currently permit committing them.  The
# setup script installs only the fixed files needed by the experiment.
models/**/*.onnx
models/**/*.pth
models/**/*.pt
.cache/torch/
.cache/huggingface/
.cache/pip/
.cache/perceptual_torch/

# Hugging Face / Torch global caches are machine-local dependency caches, not
# reproducibility assets.  Deliberately admitted assets belong in a reviewed
# repository path and are covered by the root .gitattributes LFS rules.
hf_cache/
torch_cache/

# Packaging / coverage / debug
*.egg-info/
.coverage
htmlcov/
.tox/
tmp/
debug/
*.log
*.tmp
*.temp
